# --- required ---
TG_BOT_TOKEN=123456:ABCDEF...         # from @BotFather
TG_CHAT_ID=123456789                  # your numeric chat id (from @userinfobot)

# --- identity (used inside persona prompts) ---
USER_NAME=you                         # how the bot will refer to you
BOT_NAME=assistant                    # the bot's own name / self-reference

# --- paths (optional, defaults are sensible) ---
# HERALD_HOME=$HOME/.herald
# PERSONA_FILE=$HERALD_HOME/persona.txt
# PROJECTS_FILE=$HERALD_HOME/projects.json

# --- claude cli ---
CLAUDE_MODEL=claude-opus-4-7          # any model your claude -p has access to

# --- timings (seconds) ---
# DEBOUNCE_MIN_SECS=300                # 5min — shortest batch wait
# DEBOUNCE_MAX_SECS=3600               # 1h  — longest batch wait when silent
# MAX_BATCH_WAIT_ACTIVE=1800           # hard cap when user is active
# MAX_BATCH_WAIT_INACTIVE=7200         # hard cap when user is away (2h)
# MAX_PENDING_COUNT=12                 # flush regardless of time at this many events
# USER_ACTIVE_WINDOW=1800              # "user is active" = TG msg in last 30min
